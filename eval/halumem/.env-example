# OpenAI-compatible API (required)
OPENAI_API_KEY=xxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
OPENAI_MAX_TOKENS=16384
OPENAI_TEMPERATURE=0.0
OPENAI_TIMEOUT=300

RETRY_TIMES=3
WAIT_TIME=0
WAIT_TIME_LOWER=0
WAIT_TIME_UPPER=0

# Optional MemBook ToC / retrieval toggles (defaults are usually fine)
# MEMBOOK_USE_BM25=1
# MEMBOOK_USE_DENSE_RETRIEVER=1
# MEMBOOK_USE_PAGE_INDEX=1
# MEMBOOK_EVAL_VERBOSE=0
# MEMBOOK_EVAL_EXTRACT_MODE=confirmed_list
